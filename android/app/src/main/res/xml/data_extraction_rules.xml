<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules.

  Nothing in this app may leave the device through cloud backup or
  device-to-device transfer: the bot token (flutter_secure_storage),
  recipients and send history would otherwise be restored onto a fresh
  install — which made a reinstalled app claim "connected" without the
  user ever connecting a bot.

  android:allowBackup="false" in the manifest already disables backups;
  these rules are defense in depth for OEM transfer paths (Android 12+).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
